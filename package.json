{
  "name": "m-ensemble",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Mahimur Rahman Khan",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace @m-ensemble/server",
    "dev:mobile": "npm run start --workspace @m-ensemble/mobile",
    "build": "npm run build --workspace @m-ensemble/shared && npm run build --workspace @m-ensemble/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
