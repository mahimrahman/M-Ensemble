# Copy to .env. Expo only exposes vars prefixed with EXPO_PUBLIC_ to the client.

# PHASE 1-4: leave true, every screen reads the in-memory fixtures.
# PHASE 5: set to false to point the same screens at the real server.
EXPO_PUBLIC_USE_MOCKS=true

# Use your machine's LAN IP (not localhost) when testing on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
