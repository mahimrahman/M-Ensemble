# Copy to .env. Expo only exposes vars prefixed with EXPO_PUBLIC_ to the client.

# The API the app talks to. There is no mock mode: every screen reads and
# writes the real database, so this must point at a running server.
#
# Use your machine's LAN IP, not localhost, when testing on a physical device -
# localhost on a phone means the phone. Re-check it whenever the network
# changes; the hotspot fallback hands out a different address.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api
