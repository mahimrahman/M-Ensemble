{
  "expo": {
    "name": "M’Ensemble",
    "slug": "m-ensemble",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mensemble",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahimrahman.mensemble",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "CFBundleDisplayName": "M’Ensemble"
      }
    },
    "android": {
      "package": "com.mahimrahman.mensemble",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F7EF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "M’Ensemble",
      "shortName": "M’Ensemble",
      "themeColor": "#061E1B",
      "backgroundColor": "#F7F7EF",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7F7EF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A5247",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "M’Ensemble uses your location to find your city and show its mosques and events."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "M’Ensemble uses the camera to scan check-in codes at events."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "M’Ensemble lets mosque coordinators choose a poster for an event or class from their photos.",
          "cameraPermission": "M’Ensemble lets mosque coordinators photograph a poster for an event or class."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {}
    },
    "backgroundColor": "#F2F7F6"
  }
}
