{
  "expo": {
    "name": "M-Ensemble",
    "slug": "m-ensemble",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mensemble",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahimrahman.mensemble",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.mahimrahman.mensemble",
      "adaptiveIcon": {
        "backgroundColor": "#482A1A"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#1C5F64",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {}
    }
  }
}
