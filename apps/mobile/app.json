{
  "expo": {
    "name": "M-Ensemble",
    "slug": "m-ensemble",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mensemble",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahimrahman.mensemble",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.mahimrahman.mensemble",
      "adaptiveIcon": {
        "backgroundColor": "#061E1B"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#0A5247",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "M’Ensemble uses your location to find your city and show its mosques and events."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "M’Ensemble uses the camera to scan check-in codes at events."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {}
    },
    "backgroundColor": "#F2F7F6",
    "splash": {
      "backgroundColor": "#061E1B",
      "resizeMode": "contain"
    }
  }
}
