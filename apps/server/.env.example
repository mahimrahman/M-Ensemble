# Copy to .env and fill in. .env is gitignored.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/m_ensemble
CORS_ORIGIN=*
LOG_LEVEL=dev

# Signs the session tokens. Any non-empty string works locally.
JWT_SECRET=change-me

# Optional. Only needed if Expo starts rate-limiting the push API.
EXPO_ACCESS_TOKEN=

# Where uploaded posters are written, relative to this directory. The default
# works out of the box; in production point it at a mounted volume, or the
# images vanish on the next redeploy.
UPLOAD_DIR=./uploads

# ─── The super-admin console ────────────────────────────────────────────────
# The account `npm run seed` creates, or promotes if the email already exists.
# It signs in to the dashboard at http://localhost:5173.
#
# In an env var rather than a literal in the seed so the credential for the
# console that mints mosque logins and moves money is not in the repository.
# Change both anywhere the database is not a laptop's.
SUPERADMIN_EMAIL=admin@mensemble.app
SUPERADMIN_PASSWORD=mensemble-admin
SUPERADMIN_NAME=Platform Admin
