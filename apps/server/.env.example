# M'Ensemble API — environment
#
# Copy to .env and fill in. .env is gitignored; never commit a filled-in copy.
# The source of truth for every name here is src/config/env.ts — if the two
# disagree, env.ts wins and this file is out of date.
#
# ─── Mandatory in production ─────────────────────────────────────────────────
# With NODE_ENV=production the server REFUSES TO START (assertProductionConfig)
# unless all of these hold:
#
#   JWT_SECRET            32+ random characters, not one of the known defaults
#   CORS_ORIGIN           explicit origins, not *
#   SUPERADMIN_EMAIL      changed from admin@mensemble.app
#   SUPERADMIN_PASSWORD   changed from the default, 12+ characters
#   EMAIL_PROVIDER        resend or smtp (console is refused)
#   PUBLIC_API_URL        set, https://
#   PUBLIC_WEB_URL        set
#   S3_BUCKET + S3_*      set, so uploads survive a redeploy
#   STRIPE_WEBHOOK_SECRET set whenever STRIPE_SECRET_KEY is
#   STRIPE_SECRET_KEY     a live key (sk_live_…), never sk_test_
#   SENTRY_DSN            set
#
# Everything else has a default that is fine on a server. Secrets belong in
# the host's secret store (Render/Fly secrets, or /srv/m-ensemble/api.env on a
# VPS with mode 600) — see infra/README.md.

# ─── Core ────────────────────────────────────────────────────────────────────
# development | test | production. Production turns on the checks above, JSON
# logs, and the real email/upload backends.
NODE_ENV=development
PORT=4000

# Local Mongo for a laptop; Atlas in production, e.g.
# mongodb+srv://m-ensemble-api:<password>@prod.xxxxx.mongodb.net/m_ensemble?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/m_ensemble

# Comma-separated browser origins allowed to call the API. `*` is refused in
# production. The mobile app is not a browser and needs no entry; the console
# normally sits behind nginx on the same origin and needs none either — list it
# only if it is served from a different host than the API it calls.
CORS_ORIGIN=*

# morgan format for the HTTP access log: dev | tiny | combined | short.
LOG_LEVEL=dev
# pino level for everything else (debug|info|warn|error). Defaults: debug on a
# laptop, info in production.
# PINO_LEVEL=info

# Signs session tokens. Generate: `openssl rand -base64 48`. Rotating it signs
# everyone out.
JWT_SECRET=change-me

# How long a sign-in lasts without being revoked (jsonwebtoken duration).
TOKEN_TTL=30d

# Only needed if Expo's push API starts rate-limiting us.
EXPO_ACCESS_TOKEN=

# ─── Where things live ───────────────────────────────────────────────────────
# The API's own public origin. Used in emails and as the Stripe redirect base.
PUBLIC_API_URL=https://api.mensemble.ca
# The marketing/legal site. Emails and the app link to terms and privacy here.
PUBLIC_WEB_URL=https://mensemble.ca
# The console, for links in operator emails (new ticket, failed payment…).
PUBLIC_ADMIN_URL=https://admin.mensemble.ca
# The app's deep-link scheme. Must match apps/mobile/app.json.
APP_SCHEME=mensemble

# ─── Uploads ─────────────────────────────────────────────────────────────────
# Without S3 configured, posters are written here and served from /uploads.
# Fine on a laptop; useless in a container, whose disk vanishes on redeploy.
UPLOAD_DIR=./uploads

# S3-compatible object storage: AWS S3, Cloudflare R2 or MinIO. Set all of
# S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY and S3_PUBLIC_URL to switch
# the backend on; with any missing the server falls back to UPLOAD_DIR.
#
# Cloudflare R2 (recommended — no egress fees, and the bucket can live in a
# Canadian jurisdiction hint: set "Location hint" to North America East when
# creating it):
#   1. R2 → Create bucket `m-ensemble-posters`.
#   2. Bucket → Settings → Public access → connect a custom domain,
#      e.g. cdn.mensemble.ca. That domain is S3_PUBLIC_URL.
#   3. R2 → Manage API tokens → Create token, "Object Read & Write" on that
#      one bucket. Copy the Access Key ID / Secret Access Key.
#   4. S3_ENDPOINT is https://<accountid>.r2.cloudflarestorage.com and
#      S3_REGION stays `auto`.
# AWS S3: leave S3_ENDPOINT empty, set S3_REGION=ca-central-1, put CloudFront
# (or the bucket's website endpoint) in S3_PUBLIC_URL, and give the IAM user
# s3:PutObject + s3:DeleteObject on the bucket only.
#
# Objects are written as posters/<yyyy>/<mm>/<uuid>.jpg with a one-year
# immutable Cache-Control, so a CDN in front needs no invalidation ever.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Images one user may upload per rolling 24 hours. Super admins are exempt.
UPLOAD_DAILY_QUOTA=50

# ─── Email ───────────────────────────────────────────────────────────────────
# resend | smtp | console. `console` prints the message to the log — the
# laptop default, refused in production because password resets need to arrive.
EMAIL_PROVIDER=console
# The From header. The domain must be verified with the provider.
EMAIL_FROM="M'Ensemble <no-reply@mensemble.ca>"
# Where replies go, and the address in every footer.
SUPPORT_EMAIL=support@mensemble.ca

# Resend (https://resend.com):
#   1. Domains → Add domain `mensemble.ca` → add the DKIM/SPF records it shows
#      to DNS, wait for "Verified".
#   2. Add a DMARC record too: `_dmarc.mensemble.ca TXT "v=DMARC1; p=quarantine;
#      rua=mailto:dmarc@mensemble.ca"`.
#   3. API Keys → Create, "Sending access", restricted to that domain.
RESEND_API_KEY=

# SMTP alternative (Postmark, SES, a mailbox provider). Ignored unless
# EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for implicit TLS on 465; false (STARTTLS) on 587.
SMTP_SECURE=false

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Leave empty and every billing route answers 503 — fine for development
# without payments. Test keys (sk_test_) on staging and laptops; the server
# refuses a test key in production.
STRIPE_SECRET_KEY=
#
# Webhook setup (do this per environment — staging and production each get
# their own endpoint and secret):
#   Dashboard → Developers → Webhooks → Add endpoint
#     URL:    ${PUBLIC_API_URL}/webhooks/stripe
#     Events: checkout.session.completed
#             invoice.paid
#             invoice.payment_failed
#             customer.subscription.updated
#             customer.subscription.deleted
#             account.updated
#             charge.refunded
#   Copy the endpoint's "Signing secret" (whsec_…) here. The handler verifies
#   every event against it and ignores anything unsigned.
#   Locally: `stripe listen --forward-to localhost:4000/webhooks/stripe` and use
#   the whsec_ it prints.
STRIPE_WEBHOOK_SECRET=
# true → Stripe Tax works out GST/QST/HST from the customer's address. Needs
# Stripe Tax enabled on the account and a registration for QC + federal.
STRIPE_AUTOMATIC_TAX=false
# Fallback when automatic tax is off: comma-separated tax rate ids (txr_…)
# applied to every invoice line, e.g. one for GST 5% and one for QST 9.975%.
STRIPE_TAX_RATE_IDS=
# Stripe Connect Express account country for mosques receiving donations.
STRIPE_CONNECT_COUNTRY=CA

# ─── Observability ───────────────────────────────────────────────────────────
# Sentry project DSN (Settings → Projects → <api> → Client Keys). Required in
# production; empty disables Sentry entirely.
SENTRY_DSN=
# Tag events with the environment so staging noise is filterable. Defaults to
# NODE_ENV when unset.
SENTRY_ENVIRONMENT=
# Fraction of requests traced for performance. 0.1 = 10%.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Rate limits (requests per window per IP) ────────────────────────────────
# 15 minutes by default. Auth routes (login, signup, reset) are tight; the
# general API cap exists only to stop one client from flooding the box.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=600

# ─── The super-admin console ─────────────────────────────────────────────────
# The account `npm run seed` creates, or promotes if the email already exists.
# In an env var rather than a literal in the seed so the credential for the
# console that mints mosque logins and moves money is not in the repository.
# Both must change anywhere the database is not a laptop's.
SUPERADMIN_EMAIL=admin@mensemble.app
SUPERADMIN_PASSWORD=mensemble-admin
SUPERADMIN_NAME=Platform Admin

# The seed refuses to run against a production database unless this is true.
# Set it for the one first-boot seed, then remove it.
ALLOW_SEED_IN_PRODUCTION=false
